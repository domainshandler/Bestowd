generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MembershipRole {
  OWNER
  MEMBER
}

enum FamilyType {
  FAMILY
  FRIENDS
  SCHOOL
  NEIGHBOURS
  OTHER
}

enum FamilyStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum OccasionType {
  BIRTHDAY
  HOLIDAY
  ONE_OFF
}

enum OccasionStatus {
  NOT_STARTED
  IDEA_SAVED
  BOUGHT
  GIVEN
}

enum Rsvp {
  NONE
  YES
  NO
  MAYBE
}

enum GiftDirection {
  GIVEN
  RECEIVED
}

enum GiftStatus {
  BOUGHT
  GIVEN
}

enum Reaction {
  LOVED_IT
  LIKED_IT
  ALREADY_HAD_IT
  NOT_A_HIT
}

enum IdeaStatus {
  SAVED
  BOUGHT
  DISMISSED
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum InviteKind {
  FAMILY
  GROUP
}

enum MoveStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

model User {
  id             String   @id @default(cuid())
  googleId       String?  @unique
  email          String   @unique
  name           String
  avatarUrl      String?
  identitySource String   @default("google")
  emailVerified  Boolean  @default(false)
  primaryGroupId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  primaryGroup    Group?            @relation("PrimaryGroup", fields: [primaryGroupId], references: [id], onDelete: SetNull)
  memberships     GroupMembership[]
  createdGifts    GiftEntry[]       @relation("GiftCreatedBy")
  createdIdeas    Idea[]            @relation("IdeaCreatedBy")
  createdInvites  InviteLink[]      @relation("InviteCreatedBy")
  acceptedInvites InviteLink[]      @relation("InviteAcceptedBy")
  moveRequests    MoveRequest[]     @relation("MoveRequestedBy")
  moveDecisions   MoveRequest[]     @relation("MoveDecidedBy")
  devices         Device[]
  people          Person[]
}

model Group {
  id                  String    @id @default(cuid())
  name                String
  currency            String    @default("CAD")
  defaultBudgets      Json      @default("{}")
  defaultReminderDays Int[]     @default([14, 3])
  /// Built-in holidays the group said it doesn't celebrate: no longer suggested.
  dismissedHolidays   String[]  @default([])
  /// When the group answered "Which holidays do you celebrate?". Until then Home asks.
  holidaysChosenAt    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  memberships     GroupMembership[]
  primaryFor      User[]            @relation("PrimaryGroup")
  families        Family[]          @relation("GroupFamilies")
  householdFamily Family?           @relation("GroupHousehold")
  people          Person[]
  occasions       Occasion[]
  gifts           GiftEntry[]
  ideas           Idea[]
  invites         InviteLink[]
  movesIn         MoveRequest[]     @relation("MoveInto")
  movesOut        MoveRequest[]     @relation("MoveFrom")
  notices         GroupNotice[]
}

model GroupMembership {
  groupId   String
  userId    String
  role      MembershipRole @default(MEMBER)
  createdAt DateTime       @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model Family {
  id                 String       @id @default(cuid())
  groupId            String
  householdOfGroupId String?      @unique
  name               String
  type               FamilyType   @default(FAMILY)
  status             FamilyStatus @default(ACTIVE)
  photoUrl           String?
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  group             Group              @relation("GroupFamilies", fields: [groupId], references: [id], onDelete: Cascade)
  householdOf       Group?             @relation("GroupHousehold", fields: [householdOfGroupId], references: [id], onDelete: Cascade)
  people            Person[]
  occasions         Occasion[]
  gifts             GiftEntry[]
  invites           InviteLink[]
  occasionCoverage  OccasionFamily[]
  connection        FamilyConnection?  @relation("ConnectedFamily")
  sharedConnections FamilyConnection[] @relation("SourceFamily")

  @@index([groupId])
}

model Person {
  id           String    @id @default(cuid())
  groupId      String
  familyId     String
  /// Set when this person signs in to the group. They're in its household.
  userId       String?
  name         String
  relationship String?
  birthMonth   Int?
  birthDay     Int?
  birthYear    Int?
  likes        String[]  @default([])
  avoid        String[]  @default([])
  sizes        Json      @default("{}")
  foodNotes    String?
  photoUrl     String?
  notes        String?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  group     Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  family    Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  occasions Occasion[]
  gifts     GiftEntry[]
  credits   GiftCredit[]
  ideaTags  IdeaPerson[]

  @@unique([groupId, userId])
  @@index([familyId])
}

model Occasion {
  id                 String         @id @default(cuid())
  groupId            String
  personId           String?
  familyId           String?
  type               OccasionType
  name               String
  date               DateTime
  recursAnnually     Boolean        @default(true)
  recurrenceEndsAt   DateTime?
  nextOccurrence     DateTime?
  budget             Decimal?       @db.Decimal(10, 2)
  status             OccasionStatus @default(NOT_STARTED)
  needsCard          Boolean        @default(false)
  cardDone           Boolean        @default(false)
  reminderDays       Int[]          @default([])
  partyAt            DateTime?
  location           String?
  rsvp               Rsvp           @default(NONE)
  hostGiftRequest    String?
  /// Group-wide occasions (no person or family): the built-in holiday this is, from src/holidays/catalog.ts.
  holidayKey         String?
  /// Group-wide occasions: budget per family type, e.g. {"SCHOOL": 20}. Overrides `budget`.
  familyTypeBudgets  Json           @default("{}")
  /// Group-wide occasions: families added to the group later are covered too.
  includeNewFamilies Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  group    Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  person   Person?          @relation(fields: [personId], references: [id], onDelete: Cascade)
  family   Family?          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  gifts    GiftEntry[]
  ideas    Idea[]
  coverage OccasionFamily[]

  @@unique([groupId, holidayKey])
  @@index([groupId, nextOccurrence])
}

/// A family covered by a group-wide occasion, with an optional budget just for them.
model OccasionFamily {
  occasionId String
  familyId   String
  budget     Decimal? @db.Decimal(10, 2)

  occasion Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  family   Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@id([occasionId, familyId])
  @@index([familyId])
}

model GiftEntry {
  id             String        @id @default(cuid())
  groupId        String
  direction      GiftDirection
  title          String
  category       String?
  occasionId     String?
  occasionDate   DateTime?
  date           DateTime
  personId       String?
  familyId       String?
  amount         Decimal?      @db.Decimal(10, 2)
  status         GiftStatus?
  valueHidden    Boolean       @default(false)
  hasGiftReceipt Boolean       @default(false)
  returnBy       DateTime?
  thankYouSent   Boolean       @default(false)
  thankYouDueAt  DateTime?
  reaction       Reaction?
  photoUrl       String?
  notes          String?
  ideaId         String?
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  group     Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  occasion  Occasion?    @relation(fields: [occasionId], references: [id], onDelete: SetNull)
  person    Person?      @relation(fields: [personId], references: [id], onDelete: Cascade)
  family    Family?      @relation(fields: [familyId], references: [id], onDelete: Cascade)
  idea      Idea?        @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  createdBy User         @relation("GiftCreatedBy", fields: [createdById], references: [id])
  credits   GiftCredit[]

  @@index([groupId, date])
}

model GiftCredit {
  giftEntryId String
  personId    String

  giftEntry GiftEntry @relation(fields: [giftEntryId], references: [id], onDelete: Cascade)
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([giftEntryId, personId])
}

model Idea {
  id          String     @id @default(cuid())
  groupId     String
  title       String
  category    String?
  url         String?
  imageUrl    String?
  price       Decimal?   @db.Decimal(10, 2)
  notes       String?
  ageMin      Int?
  ageMax      Int?
  status      IdeaStatus @default(SAVED)
  occasionId  String?
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  group     Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  occasion  Occasion?    @relation(fields: [occasionId], references: [id], onDelete: SetNull)
  createdBy User         @relation("IdeaCreatedBy", fields: [createdById], references: [id])
  tags      IdeaPerson[]
  gifts     GiftEntry[]

  @@index([groupId])
}

model IdeaPerson {
  ideaId   String
  personId String

  idea   Idea   @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([ideaId, personId])
}

model InviteLink {
  id           String     @id @default(cuid())
  token        String     @unique
  kind         InviteKind
  groupId      String
  familyId     String?
  createdById  String
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  createdAt    DateTime   @default(now())

  group      Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  family     Family? @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy  User    @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  acceptedBy User?   @relation("InviteAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
}

model FamilyConnection {
  id             String   @id @default(cuid())
  familyId       String   @unique
  sourceFamilyId String
  sharedFields   String[]
  createdAt      DateTime @default(now())

  family       Family @relation("ConnectedFamily", fields: [familyId], references: [id], onDelete: Cascade)
  sourceFamily Family @relation("SourceFamily", fields: [sourceFamilyId], references: [id], onDelete: Cascade)
}

model Device {
  id         String         @id @default(cuid())
  userId     String
  platform   DevicePlatform
  token      String         @unique
  createdAt  DateTime       @default(now())
  lastSeenAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A member asking to bring things from their own group into this one. The group's owner approves it.
model MoveRequest {
  id            String     @id @default(cuid())
  groupId       String
  /// Null once the source group is gone (removed after everything moved).
  fromGroupId   String?
  fromGroupName String
  requestedById String
  /// Families to bring, with their people, gifts and occasions. May include the source household.
  familyIds     String[]
  /// Group-wide occasions (holidays) to bring.
  occasionIds   String[]
  ideas         Boolean    @default(false)
  status        MoveStatus @default(PENDING)
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime   @default(now())

  group       Group  @relation("MoveInto", fields: [groupId], references: [id], onDelete: Cascade)
  fromGroup   Group? @relation("MoveFrom", fields: [fromGroupId], references: [id], onDelete: SetNull)
  requestedBy User   @relation("MoveRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  decidedBy   User?  @relation("MoveDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([groupId, status])
}

/// Something the group's members should know about, such as someone leaving. Shown on Home for 30 days.
model GroupNotice {
  id          String   @id @default(cuid())
  groupId     String
  text        String
  /// Users who closed it.
  dismissedBy String[] @default([])
  createdAt   DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
}
