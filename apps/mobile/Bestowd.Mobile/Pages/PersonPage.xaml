<?xml version="1.0" encoding="UTF-8" ?>
<pages:BasePage x:TypeArguments="vm:PersonViewModel"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Bestowd.Mobile.Pages"
             xmlns:vm="clr-namespace:Bestowd.Core.ViewModels;assembly=Bestowd.Core"
             x:Class="Bestowd.Mobile.Pages.PersonPage"
             x:DataType="vm:PersonViewModel"
             Title="{Binding Person.Name}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Edit" Command="{Binding EditCommand}" />
    </ContentPage.ToolbarItems>
    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="20,8,20,32" Spacing="22">
                <Label Text="{Binding Error}" Style="{StaticResource ErrorText}" IsVisible="{Binding Error, Converter={StaticResource Has}}" />

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <pages:Avatar Name="{Binding Person.Name}" Size="64" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                        <Label Text="{Binding Person.Name}" Style="{StaticResource Title}" />
                        <Label Text="{Binding Summary}" Style="{StaticResource Small}" FontSize="14" />
                        <Label Text="{Binding Person.FamilyName}" Style="{StaticResource LinkText}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenFamilyCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>
                </Grid>

                <pages:NotesCard BindingContext="{Binding Notes}" />

                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Occasions" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="+ Add" Style="{StaticResource Ghost}" Command="{Binding AddOccasionCommand}" />
                    </Grid>
                    <Label Text="No occasions yet. Add a birthday to get reminders." Style="{StaticResource Small}" IsVisible="{Binding Occasions, Converter={StaticResource Has}, ConverterParameter=invert}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Occasions}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:OccasionItem">
                                <pages:OccasionRow />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Gift history" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="4" BackgroundColor="{StaticResource Chip}" Padding="4">
                        <Button x:Name="GivenButton" Text="Given" Style="{StaticResource ChipOn}" CornerRadius="9" Clicked="OnGiven" />
                        <Button x:Name="ReceivedButton" Grid.Column="1" Text="Received" Style="{StaticResource ChipOff}" CornerRadius="9" BorderWidth="0" Clicked="OnReceived" />
                    </Grid>
                    <Label Text="{Binding HistoryEmptyText}" Style="{StaticResource Small}" IsVisible="{Binding History, Converter={StaticResource Has}, ConverterParameter=invert}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding History}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:GiftSection">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding Title}" Style="{StaticResource Caps}" FontSize="13" />
                                    <Border Style="{StaticResource Card}" Padding="0">
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vm:GiftItem">
                                                    <pages:GiftRow />
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="+ Log a gift" Style="{StaticResource Dashed}" Command="{Binding LogGiftCommand}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Ideas" Style="{StaticResource SectionTitle}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="See all" Style="{StaticResource Ghost}" Command="{Binding SeeIdeasCommand}" />
                    </Grid>
                    <Border BackgroundColor="{StaticResource AmberSoft}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12,10" IsVisible="{Binding RepeatNotice, Converter={StaticResource Has}}">
                        <Label Text="{Binding RepeatNotice}" FontSize="13" TextColor="{StaticResource ChipInk}" />
                    </Border>
                    <Label Text="No saved ideas yet." Style="{StaticResource Small}" IsVisible="{Binding Ideas, Converter={StaticResource Has}, ConverterParameter=invert}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Ideas}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:IdeaRow">
                                <Border Style="{StaticResource Card}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding Idea.Title}" Style="{StaticResource Strong}" />
                                        <Label Grid.Column="1" Text="{Binding PriceText}" FontFamily="InterSemiBold" FontSize="14" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <HorizontalStackLayout Spacing="8">
                    <Button Text="{Binding ArchiveText}" Style="{StaticResource Secondary}" Command="{Binding ToggleArchiveCommand}" />
                    <Button Text="Delete" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</pages:BasePage>
