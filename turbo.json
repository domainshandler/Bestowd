{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_URL_TEST",
        "DIRECT_URL",
        "JWT_SECRET",
        "ENCRYPTION_KEY",
        "GOOGLE_CLIENT_ID",
        "GMAIL_USER",
        "GMAIL_APP_PASSWORD",
        "WEB_APP_URL",
        "ALLOWED_ORIGINS",
        "NODE_ENV"
      ],
      "cache": false
    },
    "lint": {}
  }
}
