<?xml version="1.0" encoding="UTF-8" ?>
<pages:BasePage x:TypeArguments="vm:IdeasViewModel"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Bestowd.Mobile.Pages"
             xmlns:vm="clr-namespace:Bestowd.Core.ViewModels;assembly=Bestowd.Core"
             x:Class="Bestowd.Mobile.Pages.IdeasPage"
             x:DataType="vm:IdeasViewModel"
             Shell.NavBarIsVisible="False"
             Title="Ideas">
    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="20,24,20,24" Spacing="16">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Label Text="Ideas" Style="{StaticResource Title}" />
                    <Button Grid.Column="1" Text="+ Add" Style="{StaticResource Secondary}" Command="{Binding AddIdeaCommand}" VerticalOptions="Center" />
                    <pages:AccountButton Grid.Column="2" />
                </Grid>

                <Border Style="{StaticResource Card}" Padding="14,10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Ideas for (everyone unless you choose)" Style="{StaticResource FieldLabel}" />
                        <pages:RecipientPickerView BindingContext="{Binding Filter}" />
                        <Label Text="{Binding Header}" Style="{StaticResource Small}" IsVisible="{Binding Header, Converter={StaticResource Has}}" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource AmberSoft}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="12,10"
                        IsVisible="{Binding RepeatNotice, Converter={StaticResource Has}}">
                    <Label Text="{Binding RepeatNotice}" FontSize="13" TextColor="{StaticResource ChipInk}" />
                </Border>

                <Label Text="{Binding Error}" Style="{StaticResource ErrorText}" IsVisible="{Binding Error, Converter={StaticResource Has}}" />
                <Label Text="{Binding EmptyText}" Style="{StaticResource Small}" HorizontalTextAlignment="Center" Margin="0,16" IsVisible="{Binding IsEmpty}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Ideas}" Spacing="10">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:IdeaCard">
                            <Border Style="{StaticResource Card}" Padding="16" StrokeShape="RoundRectangle 18">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="✦ Top pick" FontFamily="InterSemiBold" FontSize="12" TextColor="{StaticResource Brand}" IsVisible="{Binding IsTopPick}" VerticalOptions="Center" />
                                        <Label Text="{Binding Idea.Title}" FontFamily="InterSemiBold" FontSize="16" IsVisible="{Binding IsTopPick, Converter={StaticResource Not}}" />
                                        <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                            <pages:Badge Text="Repeat" Tone="Amber" IsVisible="{Binding RepeatText, Converter={StaticResource Has}}" />
                                            <Label Text="{Binding PriceText}" FontFamily="InterSemiBold" FontSize="14" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                    <Label Text="{Binding Idea.Title}" FontFamily="JakartaBold" FontSize="18" IsVisible="{Binding IsTopPick}" />
                                    <Label Text="{Binding Idea.Notes}" Style="{StaticResource Small}" FontSize="14" IsVisible="{Binding Idea.Notes, Converter={StaticResource Has}}" />
                                    <Label Text="{Binding RepeatText}" FontSize="13" TextColor="{StaticResource AmberInk}" IsVisible="{Binding RepeatText, Converter={StaticResource Has}}" />
                                    <Label Text="{Binding Meta}" Style="{StaticResource Small}" FontSize="12" IsVisible="{Binding Meta, Converter={StaticResource Has}}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Button Text="Mark as bought" IsVisible="{Binding CanBuy}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:IdeasViewModel}}, Path=BuyCommand, x:DataType=vm:IdeasViewModel}" CommandParameter="{Binding .}" />
                                        <Button Grid.Column="1" Text="Dismiss" Style="{StaticResource Secondary}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:IdeasViewModel}}, Path=DismissCommand, x:DataType=vm:IdeasViewModel}" CommandParameter="{Binding .}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</pages:BasePage>
