<?xml version="1.0" encoding="UTF-8" ?>
<pages:BasePage x:TypeArguments="vm:FamilyFormViewModel"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Bestowd.Mobile.Pages"
             xmlns:vm="clr-namespace:Bestowd.Core.ViewModels;assembly=Bestowd.Core"
             xmlns:m="clr-namespace:Bestowd.Core.Models;assembly=Bestowd.Core"
             x:Class="Bestowd.Mobile.Pages.FamilyFormPage"
             x:DataType="vm:FamilyFormViewModel"
             Title="Family">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Cancel" Command="{Binding CancelCommand}" />
    </ContentPage.ToolbarItems>
    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,32" Spacing="14">
            <VerticalStackLayout Spacing="4">
                <Label Text="Name" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBox}"><Entry Text="{Binding Name}" Placeholder="Chen family" MaxLength="100" /></Border>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="4">
                <Label Text="Type" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBox}"><Picker ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" Title="Type" /></Border>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="4">
                <Label Text="Notes" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBox}"><Editor Text="{Binding Notes}" /></Border>
            </VerticalStackLayout>
            <Label Text="{Binding Error}" Style="{StaticResource ErrorText}" IsVisible="{Binding Error, Converter={StaticResource Has}}" />
            <Button Text="Save" Command="{Binding SaveCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</pages:BasePage>
