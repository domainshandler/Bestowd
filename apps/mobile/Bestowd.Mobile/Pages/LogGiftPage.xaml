<?xml version="1.0" encoding="UTF-8" ?>
<pages:BasePage x:TypeArguments="vm:LogGiftViewModel"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:Bestowd.Mobile.Pages"
             xmlns:vm="clr-namespace:Bestowd.Core.ViewModels;assembly=Bestowd.Core"
             xmlns:m="clr-namespace:Bestowd.Core.Models;assembly=Bestowd.Core"
             x:Class="Bestowd.Mobile.Pages.LogGiftPage"
             x:DataType="vm:LogGiftViewModel"
             Title="Gift">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Cancel" Command="{Binding CancelCommand}" />
    </ContentPage.ToolbarItems>
    <ScrollView>
        <VerticalStackLayout Padding="20,12,20,32" Spacing="14">
            <Label Text="{Binding ScreenTitle}" Style="{StaticResource Title}" FontSize="26" />
            <VerticalStackLayout Spacing="6" IsVisible="{Binding Product.FromPhoto}">
                <Image Source="{Binding Product.Photo.Source}" HeightRequest="220" Aspect="AspectFit" SemanticProperties.Description="Your photo" />
                <HorizontalStackLayout Spacing="8" IsVisible="{Binding Product.Capture.IsBusy}">
                    <ActivityIndicator IsRunning="{Binding Product.Capture.IsBusy}" HeightRequest="20" />
                    <Label Text="Reading the photo…" Style="{StaticResource Small}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="{Binding Product.Capture.Note}" Style="{StaticResource Small}" TextColor="{StaticResource Brand}" IsVisible="{Binding Product.Capture.Note, Converter={StaticResource Has}}" />
                <Label Text="{Binding Product.Capture.Error}" Style="{StaticResource ErrorText}" IsVisible="{Binding Product.Capture.Error, Converter={StaticResource Has}}" />
            </VerticalStackLayout>
            <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="44" IsVisible="{Binding GiftId, Converter={StaticResource Has}, ConverterParameter=invert}">
                <Label Text="We received this" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding IsReceived}" SemanticProperties.Description="We received this" />
            </Grid>
            <VerticalStackLayout Spacing="4">
                <Label Text="Gift" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBox}"><Entry Text="{Binding Title}" Placeholder="Wooden art easel" MaxLength="200" /></Border>
                <pages:SuggestionsView BindingContext="{Binding Product.TitleSuggest}" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding SubjectLabel}" Style="{StaticResource FieldLabel}" />
                <pages:RecipientPickerView BindingContext="{Binding Who}" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="4">
                <Label Text="Occasion" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBox}"><Picker ItemsSource="{Binding Occasions}" SelectedItem="{Binding Occasion}" ItemDisplayBinding="{Binding Name, x:DataType=m:Occasion}" Title="None" /></Border>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="4">
                <Label Text="Date" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBox}"><DatePicker Date="{Binding Date}" /></Border>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding AmountLabel}" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBox}"><Entry Text="{Binding Amount}" Keyboard="Numeric" /></Border>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="4">
                <Label Text="Brand" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBox}"><Entry Text="{Binding Brand}" Placeholder="Garmin" MaxLength="80" /></Border>
                <pages:SuggestionsView BindingContext="{Binding Product.BrandSuggest}" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="4" IsVisible="{Binding IsReceived, Converter={StaticResource Not}}">
                <Label Text="Store" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBox}"><Entry Text="{Binding Store}" Placeholder="Where to buy it" MaxLength="80" /></Border>
                <pages:SuggestionsView BindingContext="{Binding Product.StoreSuggest}" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="4">
                <Label Text="Link to product" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBox}"><Entry Text="{Binding Url}" Keyboard="Url" Placeholder="https://" /></Border>
            </VerticalStackLayout>
            <Button Text="Fill in from link" Style="{StaticResource Secondary}" Command="{Binding Product.Capture.FromLinkCommand}" HorizontalOptions="Start" />
            <VerticalStackLayout Spacing="4">
                <Label Text="Category (warns about repeats, e.g. Puzzle)" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBox}"><Entry Text="{Binding Category}" MaxLength="60" /></Border>
                <pages:SuggestionsView BindingContext="{Binding Product.CategorySuggest}" />
            </VerticalStackLayout>
            <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="44"><Label Text="Bought, not given yet" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding BoughtNotGiven}" SemanticProperties.Description="Bought, not given yet" /></Grid>
            <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="44"><Label Text="Keep value hidden" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding ValueHidden}" SemanticProperties.Description="Keep value hidden" /></Grid>
            <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="44"><Label Text="Has a gift receipt" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding HasGiftReceipt}" SemanticProperties.Description="Has a gift receipt" /></Grid>
            <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="44"><Label Text="Thank-you sent" VerticalOptions="Center" /><Switch Grid.Column="1" IsToggled="{Binding ThankYouSent}" SemanticProperties.Description="Thank-you sent" /></Grid>
            <VerticalStackLayout Spacing="8" IsVisible="{Binding Product.Photo.CanPick}">
                <Label Text="Photo" Style="{StaticResource FieldLabel}" />
                <Image Source="{Binding Product.Photo.Source}" HeightRequest="160" Aspect="AspectFill" IsVisible="{Binding Product.Photo.HasPhoto}" SemanticProperties.Description="Photo" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="{Binding Product.Photo.TakeText}" Style="{StaticResource Secondary}" Command="{Binding Product.Photo.TakeCommand}" />
                    <Button Text="Choose" Style="{StaticResource Secondary}" Command="{Binding Product.Photo.ChooseCommand}" />
                    <Button Text="Remove" Style="{StaticResource Ghost}" Command="{Binding Product.Photo.RemoveCommand}" IsVisible="{Binding Product.Photo.HasPhoto}" />
                </HorizontalStackLayout>
                <ActivityIndicator IsRunning="{Binding Product.Photo.IsBusy}" IsVisible="{Binding Product.Photo.IsBusy}" />
                <Label Text="{Binding Product.Photo.Error}" Style="{StaticResource ErrorText}" IsVisible="{Binding Product.Photo.Error, Converter={StaticResource Has}}" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="6" IsVisible="{Binding Product.Photo.HasPhoto}">
                <Button Text="Fill in from photo" Style="{StaticResource Secondary}" Command="{Binding Product.Capture.FromPhotoCommand}" HorizontalOptions="Start" IsVisible="{Binding Product.Capture.CanReadPhotos}" />
                <Label Text="To read details from photos, add an AI key under Settings (the group's owner can)." Style="{StaticResource Small}" IsVisible="{Binding Product.Capture.CanReadPhotos, Converter={StaticResource Not}}" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="6" IsVisible="{Binding Product.FromPhoto, Converter={StaticResource Not}}">
                <ActivityIndicator IsRunning="{Binding Product.Capture.IsBusy}" IsVisible="{Binding Product.Capture.IsBusy}" />
                <Label Text="{Binding Product.Capture.Note}" Style="{StaticResource Small}" TextColor="{StaticResource Brand}" IsVisible="{Binding Product.Capture.Note, Converter={StaticResource Has}}" />
                <Label Text="{Binding Product.Capture.Error}" Style="{StaticResource ErrorText}" IsVisible="{Binding Product.Capture.Error, Converter={StaticResource Has}}" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="4">
                <Label Text="Notes" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBox}"><Editor Text="{Binding Notes}" /></Border>
            </VerticalStackLayout>
            <Label Text="{Binding Error}" Style="{StaticResource ErrorText}" IsVisible="{Binding Error, Converter={StaticResource Has}}" />
            <Button Text="Save" Command="{Binding SaveCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        </VerticalStackLayout>
    </ScrollView>
</pages:BasePage>
