# Copy to .env (same folder) and fill in. .env is git-ignored.

# Database password: letters and digits only (it goes into a URL).
POSTGRES_PASSWORD=change-me

# 32+ random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=
# Exactly 64 hex characters, e.g. `openssl rand -hex 32`
ENCRYPTION_KEY=

# Web OAuth client (Android sign-in uses it too). Client IDs aren't secret.
GOOGLE_CLIENT_ID=772270916348-1b8bf7q85cbb95ras0q8nkfvkuksbcmu.apps.googleusercontent.com
# iOS client ID later, comma-separated
GOOGLE_CLIENT_IDS=

# Invite emails. Placeholders let the API start; sending invites fails until these are real.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=placeholder

# Where invite links and CORS point: the web app's address
WEB_APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Firebase service-account JSON on one line, for push (optional)
FCM_SERVICE_ACCOUNT=
