<?xml version="1.0" encoding="UTF-8" ?>
<!-- Autofill chips under a text field. Its BindingContext is a Bestowd.Core.ViewModels.Suggester. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Bestowd.Core.ViewModels;assembly=Bestowd.Core"
             x:Class="Bestowd.Mobile.Pages.SuggestionsView"
             x:DataType="vm:Suggester"
             IsVisible="{Binding HasItems}">
    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
        <HorizontalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Items}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Button Text="{Binding .}" Style="{StaticResource Secondary}" Padding="12,0" MinimumHeightRequest="36" FontSize="13" CommandParameter="{Binding .}"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:Suggester}}, Path=PickCommand, x:DataType=vm:Suggester}" />
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </HorizontalStackLayout>
    </ScrollView>
</ContentView>
